generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model CompetitionEntry {
  id              String   @id @default(cuid())
  consumerName    String
  consumerPhone   String   @default("")
  consumerLocation String  @default("")
  slipPhotoUrl    String   @default("")
  slipPhotoData   String   @default("")
  validated       Boolean  @default(false)
  validationResult String  @default("pending")
  validationReason String  @default("")
  storeName       String   @default("")
  slipDate        String   @default("")
  slipAmount      String   @default("")
  championProducts String  @default("")
  confidenceScore String   @default("")
  isDuplicate     Boolean  @default(false)
  isFraud         Boolean  @default(false)
  entryNumber     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CompetitionStats {
  id              String   @id @default(cuid())
  totalEntries    Int      @default(0)
  confirmedEntries Int     @default(0)
  rejectedEntries Int      @default(0)
  duplicateEntries Int     @default(0)
  fraudEntries    Int      @default(0)
  pendingEntries  Int      @default(0)
  updatedAt       DateTime @updatedAt
}

model CompetitionWinner {
  id      String   @id @default(cuid())
  entryId String   @unique
  prize   String
  drawnAt DateTime @default(now())
}

model AdminUser {
  id          String   @id @default(cuid())
  username    String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
