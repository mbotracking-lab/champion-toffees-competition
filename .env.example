# ═══════════════════════════════════════════════════════════════
# Champion Toffees Competition — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in the values.
# For Vercel: add these in Project Settings > Environment Variables.
#

# ─── Database (Neon PostgreSQL) ───
# Required. Get this from your Neon dashboard: https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# ─── ZAI SDK (for VLM till slip validation) ───
# Required for AI validation. These are set automatically when running on Z.ai platform.
# For Vercel: copy from your .z-ai-config file or set manually.
ZAI_BASE_URL=https://your-zai-base-url
ZAI_API_KEY=your-zai-api-key
ZAI_TOKEN=
ZAI_USER_ID=
ZAI_CHAT_ID=

# ─── WhatsApp Business API (via 360dialog BSP) ───
# Required for WhatsApp integration. Get from 360dialog Hub: https://hub.360dialog.io
#
# WHATSAPP_API_TOKEN: Your 360dialog API key
# WHATSAPP_PHONE_NUMBER_ID: Phone number ID from 360dialog Hub
# WHATSAPP_VERIFY_TOKEN: Any random string — used during webhook verification
#                          Must match what you enter in 360dialog webhook settings
# BSP_PROVIDER: Set to "360dialog" (default) or "meta" for direct Meta API

WHATSAPP_API_TOKEN=your_360dialog_api_key
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=champion_webhook_verify_2026
BSP_PROVIDER=360dialog

# ─── Admin Panel ───
# Required. Set strong credentials for the /admin panel.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_a_strong_password
